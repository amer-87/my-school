{
  "name": "school-management-electron",
  "version": "1.1.6",
  "description": "School management desktop app built with Electron, React, HTML and CSS",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node electron/dev.js",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.myschool.app",
    "productName": "نظام إدارة المدارس",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "data/**/*"
    ],
    "extraResources": [
      "data/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sqlite3/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "نظام إدارة المدارس"
    }
  },
  "dependencies": {
    "nodemailer": "^10.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.0"
  }
}
